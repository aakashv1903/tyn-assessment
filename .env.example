# --- Jira Cloud ---
JIRA_SERVER=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=TYN

# --- Model provider (choose ONE path below; set MODEL_PROVIDER to match) ---
MODEL_PROVIDER=gemini
# or: MODEL_PROVIDER=anthropic

# Anthropic path (requires paid API credit)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# Gemini path (free tier via https://aistudio.google.com/apikey, no card needed)
GOOGLE_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-2.0-flash

# --- Dataset scope ---
DATASET_LABEL=tyn-release-assessment-v2
